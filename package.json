{
  "author": "juninhodeluca",
  "bugs": "https://github.com/cecil-ia-labs/d3-wordcloud-react/issues",
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.7",
    "d3-dispatch": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "seedrandom": "^3.0.5",
    "tippy.js": "^6.3.7"
  },
  "description": "D3-based word cloud component for React >= 18",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/cecil-ia-labs/d3-wordcloud-react",
  "keywords": [
    "wordcloud",
    "d3",
    "react",
    "react-18"
  ],
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "name": "@cecilialabs/d3-wordcloud-react",
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecil-ia-labs/d3-wordcloud-react.git"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --out-dir dist",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "npm run clean && npm run build",
    "refresh": "rm -rf node_modules dist package-lock.json && npm install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "source": "src/index.tsx",
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.4.7"
}